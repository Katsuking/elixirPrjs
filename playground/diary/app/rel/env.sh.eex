#!/bin/sh

# Use shortnames (sname) for single-word container hostnames like "web1" and "web2"
if [ -n "$RELEASE_NODE" ]; then
  export RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-sname}"
  export RELEASE_NODE="$RELEASE_NODE"
fi

# Set Erlang distribution cookie
if [ -n "$RELEASE_COOKIE" ]; then
  export RELEASE_COOKIE="$RELEASE_COOKIE"
fi
