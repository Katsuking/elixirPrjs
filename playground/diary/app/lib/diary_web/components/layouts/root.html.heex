<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Wayup" suffix=" · A Better You, One Day at a Time" phx-no-format>{assigns[:page_title]}</.live_title>
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://wayup.cc/" />
    <meta property="og:title" content="Wayup - 筋トレ＆生活記録日記 (Workout & Activity Diary)" />
    <meta property="og:description" content="毎日の筋トレ内容やセット数を手軽に記録し、進行状況をカレンダーやグラフで追跡できるフィットネス日記アプリです。Log your daily workouts, track your progress, and stay consistent." />
    <meta property="og:image" content={~p"/images/power.svg"} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary" />
    <meta property="twitter:url" content="https://wayup.cc/" />
    <meta property="twitter:title" content="Wayup - 筋トレ＆生活記録日記 (Workout & Activity Diary)" />
    <meta property="twitter:description" content="毎日の筋トレ内容やセット数を手軽に記録し、進行状況をカレンダーやグラフで追跡できるフィットネス日記アプリです。Log your daily workouts, track your progress, and stay consistent." />
    <meta property="twitter:image" content={~p"/images/power.svg"} />

    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <script>
      (() => {
        const systemTheme = () => matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";

        const setTheme = (theme) => {
          if (theme === "system") {
            localStorage.removeItem("phx:theme");
            document.documentElement.setAttribute("data-theme", systemTheme());
            document.documentElement.setAttribute("data-theme-source", "system");
          } else {
            localStorage.setItem("phx:theme", theme);
            document.documentElement.setAttribute("data-theme", theme);
            document.documentElement.setAttribute("data-theme-source", "user");
          }
        };
        if (!document.documentElement.hasAttribute("data-theme")) {
          setTheme(localStorage.getItem("phx:theme") || "system");
        }
        window.addEventListener("storage", (e) => e.key === "phx:theme" && setTheme(e.newValue || "system"));
        window.addEventListener("phx:set-theme", (e) => setTheme(e.target.dataset.phxTheme));

        matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (e) => {
          if (document.documentElement.getAttribute("data-theme-source") === "system") {
            document.documentElement.setAttribute("data-theme", systemTheme());
          }
        });
      })();
    </script>
    <%= if gtag_id = System.get_env("GTAG_ID") do %>
      <!-- Google tag (gtag.js) -->
      <script async src={"https://www.googletagmanager.com/gtag/js?id=" <> gtag_id}></script>
      <script>
        // Initialize the global dataLayer for Google Analytics
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());

        // Configure initial page view with the dynamic measurement ID
        gtag('config', '<%= gtag_id %>');
        
        // Expose the measurement ID globally so that assets/js/app.js can reference it for LiveView navigation tracking
        window.gtagId = '<%= gtag_id %>';
      </script>
    <% end %>
  </head>
  <body>
    <!-- Align header items to the end (right) and remove user email display for a cleaner layout. Increase z-index to z-50 to make sure the dropdown shows on top of other content. -->
    <ul class="menu menu-horizontal w-full relative z-50 flex items-center gap-4 px-4 sm:px-6 lg:px-8 justify-end">
      <!-- Render locale selector as a direct li menu item to prevent dead hover zones in the nav bar -->
      <.locale_select current_locale={Gettext.get_locale(DiaryWeb.Gettext)} class="mr-2 border-r border-slate-200 dark:border-zinc-800 pr-4" />
      <%= if @current_scope && @current_scope.user do %>
        <!-- User avatar icon linking to settings -->
        <li class="flex items-center">
          <.link href={~p"/users/settings"} title={gettext("Settings")}>
            <.user_avatar user={@current_scope.user} size={:md} />
          </.link>
        </li>
        <li>
          <.link href={~p"/users/settings"}><%= gettext("Settings") %></.link>
        </li>
        <li>
          <.link href={~p"/users/log-out"} method="delete"><%= gettext("Log out") %></.link>
        </li>
      <% else %>
        <li>
          <.link href={~p"/users/register"}><%= gettext("Register") %></.link>
        </li>
        <li>
          <.link href={~p"/users/log-in"}><%= gettext("Log in") %></.link>
        </li>
      <% end %>
    </ul>
    {@inner_content}
  </body>
</html>
