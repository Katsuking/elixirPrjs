# --- Production Database Credentials ---
DB_USER=db_username_here
DB_PASSWORD=db_pwd_here
DB_NAME=db_name_here

# --- Phoenix Application Secret Key ---
# Generate a new unique secret key using: mix phx.gen.secret
SECRET_KEY_BASE=

# --- Swoosh Mailer Config (Optional) ---
# Available adapters: mailgun, sendgrid, ses, brevo, local, logger
# If not specified, defaults to "logger" (console output)
MAILER_ADAPTER=logger

# MAILGUN_API_KEY=key-xxxxxxxxxxxxxxxxxxxxxxxx
# MAILGUN_DOMAIN=mg.yourdomain.com
# BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Host / Domain Configuration ---
PHX_HOST=yourdomain.com

# --- Erlang Cluster Secret Cookie ---
# Generate a secret string for node authentication (e.g. openssl rand -base64 32)
RELEASE_COOKIE=secret_cluster_cookie_string_here

