---
import type { CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ShareButtons from '../components/ShareButtons.astro';
import PrevNextPost from '../components/PrevNextPost.astro';
import RelatedPosts from '../components/RelatedPosts.astro';

// Props interface for blog layout
interface Props {
  title: string;
  pubDate: Date | string;
  description?: string;
  author?: string;
  readingTime?: string;
  category?: {
    main: string;
    sub?: string;
    child?: string;
  };
  tags?: string[];
  prevPost?: CollectionEntry<'blog'>;
  nextPost?: CollectionEntry<'blog'>;
  relatedPosts?: CollectionEntry<'blog'>[];
}

const {
  title,
  pubDate,
  description,
  author,
  readingTime,
  category,
  tags = [],
  prevPost,
  nextPost,
  relatedPosts = [],
} = Astro.props;
---

<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | WayUp Blog</title>
    {description && <meta name="description" content={description} />}
    <style is:global>
      /* Global styles and mobile responsiveness for blog articles */
      *, *::before, *::after {
        box-sizing: border-box;
      }

      body {
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        background-color: #0f172a;
        color: #f8fafc;
        line-height: 1.7;
        margin: 0;
        padding: 1.5rem 0.75rem;
        display: flex;
        justify-content: center;
      }

      main {
        max-width: 750px;
        width: 100%;
        background-color: #1e293b;
        padding: 2.25rem 2rem;
        border-radius: 1rem;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3);
        overflow-wrap: break-word;
        word-break: break-word;
      }

      /* Responsive headings with fluid typography */
      h1 {
        font-size: clamp(1.4rem, 4.5vw + 0.5rem, 2.25rem);
        line-height: 1.35;
        color: #38bdf8;
        margin-top: 0.5rem;
        margin-bottom: 1rem;
        overflow-wrap: break-word;
        word-break: break-word;
      }

      h2 {
        font-size: clamp(1.2rem, 3.5vw + 0.4rem, 1.75rem);
        color: #38bdf8;
        margin-top: 1.75rem;
        margin-bottom: 0.75rem;
      }

      h3 {
        font-size: clamp(1.05rem, 2.5vw + 0.3rem, 1.35rem);
        color: #38bdf8;
        margin-top: 1.5rem;
        margin-bottom: 0.5rem;
      }

      a {
        color: #f43f5e;
        text-decoration: none;
      }

      a:hover {
        text-decoration: underline;
      }

      /* Responsive images & media elements */
      main img, main video, main iframe {
        max-width: 100%;
        height: auto;
        border-radius: 0.5rem;
      }

      code {
        background-color: #0f172a;
        padding: 0.2rem 0.4rem;
        border-radius: 0.25rem;
        color: #f43f5e;
        font-size: 0.9em;
        word-break: break-word;
      }

      pre {
        background-color: #0f172a;
        padding: 1rem;
        border-radius: 0.5rem;
        overflow-x: auto;
        max-width: 100%;
      }

      pre code {
        background-color: transparent;
        padding: 0;
        color: inherit;
        word-break: normal;
      }

      .meta {
        color: #94a3b8;
        font-size: 0.85rem;
        margin-bottom: 1.75rem;
        border-bottom: 1px solid #334155;
        padding-bottom: 1rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 0.75rem;
        align-items: center;
        line-height: 1.5;
      }

      .tag-badge {
        font-size: 0.75rem;
        padding: 0.1rem 0.4rem;
        background-color: #0f172a;
        color: #38bdf8;
        border: 1px solid #334155;
        border-radius: 0.25rem;
        display: inline-block;
      }

      /* Smartphone / Mobile screen optimizations */
      @media (max-width: 640px) {
        body {
          padding: 0.5rem 0.25rem;
        }
        main {
          padding: 1.25rem 1rem;
          border-radius: 0.75rem;
        }
        .meta {
          font-size: 0.8rem;
          gap: 0.35rem 0.5rem;
        }
      }

      /* Heroicon inline alignment */
      .icon-inline {
        width: 1.1em;
        height: 1.1em;
        display: inline-block;
        vertical-align: -0.15em;
      }
    </style>
  </head>
  <body>
    <main>
      <!-- Breadcrumbs navigation -->
      <Breadcrumbs category={category} title={title} />

      <h1>{title}</h1>

      <!-- Meta information -->
      <div class="meta">
        <span>Published on {new Date(pubDate).toLocaleDateString()}</span>
        {readingTime && <span>• <Icon name="heroicons:clock" class="icon-inline" /> {readingTime}</span>}
        {tags.length > 0 && (
          <span>
            • Tags: {tags.map((tag) => <span class="tag-badge">#{tag}</span>)}
          </span>
        )}
      </div>

      <!-- Main article content -->
      <slot />

      <!-- SNS Share buttons -->
      <ShareButtons title={title} />

      <!-- Previous / Next post links -->
      <PrevNextPost prevPost={prevPost} nextPost={nextPost} />

      <!-- Related posts recommendations -->
      <RelatedPosts posts={relatedPosts} />
    </main>
  </body>
</html>
