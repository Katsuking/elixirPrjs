---
import type { CollectionEntry } from 'astro:content';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ShareButtons from '../components/ShareButtons.astro';
import PrevNextPost from '../components/PrevNextPost.astro';
import RelatedPosts from '../components/RelatedPosts.astro';

// Props interface for blog layout
interface Props {
  title: string;
  pubDate: Date | string;
  description?: string;
  author?: string;
  readingTime?: string;
  category?: {
    main: string;
    sub?: string;
    child?: string;
  };
  tags?: string[];
  prevPost?: CollectionEntry<'blog'>;
  nextPost?: CollectionEntry<'blog'>;
  relatedPosts?: CollectionEntry<'blog'>[];
}

const {
  title,
  pubDate,
  description,
  author,
  readingTime,
  category,
  tags = [],
  prevPost,
  nextPost,
  relatedPosts = [],
} = Astro.props;
---

<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | WayUp Blog</title>
    {description && <meta name="description" content={description} />}
    <style is:global>
      /* Global styles for blog articles */
      body {
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        background-color: #0f172a;
        color: #f8fafc;
        line-height: 1.7;
        margin: 0;
        padding: 2rem 1rem;
        display: flex;
        justify-content: center;
      }
      main {
        max-width: 750px;
        width: 100%;
        background-color: #1e293b;
        padding: 2.5rem;
        border-radius: 1rem;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3);
      }
      h1, h2, h3 {
        color: #38bdf8;
      }
      a {
        color: #f43f5e;
        text-decoration: none;
      }
      a:hover {
        text-decoration: underline;
      }
      code {
        background-color: #0f172a;
        padding: 0.2rem 0.4rem;
        border-radius: 0.25rem;
        color: #f43f5e;
      }
      pre {
        background-color: #0f172a;
        padding: 1rem;
        border-radius: 0.5rem;
        overflow-x: auto;
      }
      .meta {
        color: #94a3b8;
        font-size: 0.9rem;
        margin-bottom: 2rem;
        border-bottom: 1px solid #334155;
        padding-bottom: 1rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        align-items: center;
      }
      .tag-badge {
        font-size: 0.75rem;
        padding: 0.1rem 0.4rem;
        background-color: #0f172a;
        color: #38bdf8;
        border: 1px solid #334155;
        border-radius: 0.25rem;
      }
    </style>
  </head>
  <body>
    <main>
      <!-- Breadcrumbs navigation -->
      <Breadcrumbs category={category} title={title} />

      <h1>{title}</h1>

      <!-- Meta information -->
      <div class="meta">
        <span>Published on {new Date(pubDate).toLocaleDateString()}</span>
        {readingTime && <span>• ⏱️ {readingTime}</span>}
        {tags.length > 0 && (
          <span>
            • Tags: {tags.map((tag) => <span class="tag-badge">#{tag}</span>)}
          </span>
        )}
      </div>

      <!-- Main article content -->
      <slot />

      <!-- SNS Share buttons -->
      <ShareButtons title={title} />

      <!-- Previous / Next post links -->
      <PrevNextPost prevPost={prevPost} nextPost={nextPost} />

      <!-- Related posts recommendations -->
      <RelatedPosts posts={relatedPosts} />
    </main>
  </body>
</html>
