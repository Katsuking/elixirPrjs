---
import { getCollection, type CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';

// Generate static paths for all unique blog tags
export async function getStaticPaths() {
  const posts = await getCollection('blog');

  // Map to collect all tags and associated posts
  const tagMap = new Map<string, CollectionEntry<'blog'>[]>();

  for (const post of posts) {
    const tags = post.data.tags || [];
    for (const tag of tags) {
      if (!tagMap.has(tag)) {
        tagMap.set(tag, []);
      }
      tagMap.get(tag)!.push(post);
    }
  }

  return Array.from(tagMap.entries()).map(([tag, matchingPosts]) => {
    // Sort posts by date descending
    const sortedPosts = matchingPosts.sort(
      (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
    );
    return {
      params: { tag },
      props: { tag, posts: sortedPosts },
    };
  });
}

type Props = {
  tag: string;
  posts: CollectionEntry<'blog'>[];
};

const { tag, posts } = Astro.props;
---

<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>タグ: #{tag} | WayUp Blog</title>
    <style>
      *, *::before, *::after {
        box-sizing: border-box;
      }
      body {
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        background-color: #0f172a;
        color: #f8fafc;
        line-height: 1.7;
        margin: 0;
        padding: 1.5rem 0.75rem;
        display: flex;
        justify-content: center;
      }
      main {
        max-width: 800px;
        width: 100%;
        background-color: #1e293b;
        padding: 2.25rem 2rem;
        border-radius: 1rem;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3);
      }
      nav.breadcrumbs {
        font-size: 0.85rem;
        color: #94a3b8;
        margin-bottom: 1.5rem;
      }
      nav.breadcrumbs a {
        color: #38bdf8;
        text-decoration: none;
      }
      nav.breadcrumbs a:hover {
        text-decoration: underline;
      }
      h1 {
        font-size: clamp(1.2rem, 2.5vw + 0.4rem, 1.6rem);
        color: #38bdf8;
        margin-top: 0.5rem;
        margin-bottom: 0.5rem;
      }
      .count-badge {
        display: inline-block;
        font-size: 0.85rem;
        padding: 0.2rem 0.6rem;
        background-color: #0f172a;
        color: #f43f5e;
        border-radius: 0.375rem;
        margin-bottom: 2rem;
        border: 1px solid #334155;
      }
      .post-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.25rem;
      }
      .post-card {
        display: block;
        padding: 1.25rem;
        background-color: #0f172a;
        border: 1px solid #334155;
        border-radius: 0.75rem;
        text-decoration: none;
        transition: border-color 0.2s ease, transform 0.1s ease;
      }
      .post-card:hover {
        border-color: #38bdf8;
        transform: translateY(-2px);
      }
      .post-title {
        font-size: 1.1rem;
        font-weight: 700;
        color: #f8fafc;
        margin-bottom: 0.5rem;
      }
      .post-date {
        font-size: 0.8rem;
        color: #64748b;
        margin-bottom: 0.5rem;
      }
      .post-desc {
        font-size: 0.9rem;
        color: #94a3b8;
        line-height: 1.5;
      }
      .nav-links {
        margin-top: 2.5rem;
        padding-top: 1.5rem;
        border-top: 1px solid #334155;
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
      }
      .nav-links a {
        color: #38bdf8;
        text-decoration: none;
        font-size: 0.9rem;
      }
      .nav-links a:hover {
        text-decoration: underline;
      }
      .icon-inline {
        width: 1.1em;
        height: 1.1em;
        display: inline-block;
        vertical-align: -0.15em;
      }
      @media (max-width: 640px) {
        body { padding: 0.5rem 0.25rem; }
        main { padding: 1.25rem 1rem; border-radius: 0.75rem; }
      }
    </style>
  </head>
  <body>
    <main>
      <!-- Tag breadcrumbs -->
      <nav aria-label="Breadcrumb" class="breadcrumbs">
        <a href="/">Home</a> / <a href="/blog/categories">カテゴリ一覧</a> / <span>タグ: #{tag}</span>
      </nav>

      <h1><Icon name="heroicons:tag" class="icon-inline" /> タグ: #{tag}</h1>
      <div class="count-badge">全 {posts.length} 件の記事</div>

      <!-- Articles list grid for this tag -->
      <div class="post-grid">
        {posts.map((post) => (
          <a href={`/blog/${post.slug}`} class="post-card">
            <div class="post-title">{post.data.title}</div>
            <div class="post-date">
              {new Date(post.data.pubDate).toLocaleDateString()}
            </div>
            {post.data.description && (
              <div class="post-desc">{post.data.description}</div>
            )}
          </a>
        ))}
      </div>

      <!-- Back navigation links -->
      <div class="nav-links">
        <a href="/blog/categories"><Icon name="heroicons:arrow-left" class="icon-inline" /> 全カテゴリ一覧へ</a>
        <a href="/"><Icon name="heroicons:arrow-left" class="icon-inline" /> ブログトップへ</a>
      </div>
    </main>
  </body>
</html>
