---
import { getCollection, type CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';

// Generate static paths for all 3-tier category combinations
export async function getStaticPaths() {
  const posts = await getCollection('blog');

  // Map to track unique category path strings and matching posts
  const categoryMap = new Map<
    string,
    { pathParts: string[]; posts: CollectionEntry<'blog'>[] }
  >();

  for (const post of posts) {
    const cat = post.data.category;
    if (!cat || !cat.main) continue;

    // 1. Level 1: Main category
    const mainPath = cat.main;
    if (!categoryMap.has(mainPath)) {
      categoryMap.set(mainPath, { pathParts: [cat.main], posts: [] });
    }
    categoryMap.get(mainPath)!.posts.push(post);

    // 2. Level 2: Sub category
    if (cat.sub) {
      const subPath = `${cat.main}/${cat.sub}`;
      if (!categoryMap.has(subPath)) {
        categoryMap.set(subPath, { pathParts: [cat.main, cat.sub], posts: [] });
      }
      categoryMap.get(subPath)!.posts.push(post);

      // 3. Level 3: Child category
      if (cat.child) {
        const childPath = `${cat.main}/${cat.sub}/${cat.child}`;
        if (!categoryMap.has(childPath)) {
          categoryMap.set(childPath, {
            pathParts: [cat.main, cat.sub, cat.child],
            posts: [],
          });
        }
        categoryMap.get(childPath)!.posts.push(post);
      }
    }
  }

  return Array.from(categoryMap.entries()).map(([categoryPathStr, { pathParts, posts }]) => {
    // Sort posts by publish date descending
    const sortedPosts = posts.sort(
      (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
    );
    return {
      params: { category: categoryPathStr },
      props: { pathParts, posts: sortedPosts },
    };
  });
}

type Props = {
  pathParts: string[];
  posts: CollectionEntry<'blog'>[];
};

const { pathParts, posts } = Astro.props;
const currentCategoryName = pathParts[pathParts.length - 1];
const categoryBreadcrumb = pathParts.join(' / ');
---

<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>カテゴリ: {categoryBreadcrumb} | WayUp Blog</title>
    <style>
      *, *::before, *::after {
        box-sizing: border-box;
      }
      body {
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        background-color: #0f172a;
        color: #f8fafc;
        line-height: 1.7;
        margin: 0;
        padding: 1.5rem 0.75rem;
        display: flex;
        justify-content: center;
      }
      main {
        max-width: 800px;
        width: 100%;
        background-color: #1e293b;
        padding: 2.25rem 2rem;
        border-radius: 1rem;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3);
      }
      nav.breadcrumbs {
        font-size: 0.85rem;
        color: #94a3b8;
        margin-bottom: 1.5rem;
      }
      nav.breadcrumbs a {
        color: #38bdf8;
        text-decoration: none;
      }
      nav.breadcrumbs a:hover {
        text-decoration: underline;
      }
      h1 {
        font-size: clamp(1.4rem, 4.5vw + 0.5rem, 2rem);
        color: #38bdf8;
        margin-top: 0.5rem;
        margin-bottom: 0.5rem;
      }
      .count-badge {
        display: inline-block;
        font-size: 0.85rem;
        padding: 0.2rem 0.6rem;
        background-color: #0f172a;
        color: #f43f5e;
        border-radius: 0.375rem;
        margin-bottom: 2rem;
        border: 1px solid #334155;
      }
      .post-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.25rem;
      }
      .post-card {
        display: block;
        padding: 1.25rem;
        background-color: #0f172a;
        border: 1px solid #334155;
        border-radius: 0.75rem;
        text-decoration: none;
        transition: border-color 0.2s ease, transform 0.1s ease;
      }
      .post-card:hover {
        border-color: #38bdf8;
        transform: translateY(-2px);
      }
      .post-title {
        font-size: 1.1rem;
        font-weight: 700;
        color: #f8fafc;
        margin-bottom: 0.5rem;
      }
      .post-date {
        font-size: 0.8rem;
        color: #64748b;
        margin-bottom: 0.5rem;
      }
      .post-desc {
        font-size: 0.9rem;
        color: #94a3b8;
        line-height: 1.5;
      }
      .nav-links {
        margin-top: 2.5rem;
        padding-top: 1.5rem;
        border-top: 1px solid #334155;
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
      }
      .nav-links a {
        color: #38bdf8;
        text-decoration: none;
        font-size: 0.9rem;
      }
      .nav-links a:hover {
        text-decoration: underline;
      }
      .icon-inline {
        width: 1.1em;
        height: 1.1em;
        display: inline-block;
        vertical-align: -0.15em;
      }
      @media (max-width: 640px) {
        body { padding: 0.5rem 0.25rem; }
        main { padding: 1.25rem 1rem; border-radius: 0.75rem; }
      }
    </style>
  </head>
  <body>
    <main>
      <!-- Category breadcrumbs -->
      <nav aria-label="Breadcrumb" class="breadcrumbs">
        <a href="/">Home</a> / <a href="/blog/categories">カテゴリ一覧</a> / <span>{categoryBreadcrumb}</span>
      </nav>

      <h1><Icon name="heroicons:folder-open" class="icon-inline" /> カテゴリ: {currentCategoryName}</h1>
      <div class="count-badge">全 {posts.length} 件の記事</div>

      <!-- Articles list grid -->
      <div class="post-grid">
        {posts.map((post) => (
          <a href={`/blog/${post.slug}`} class="post-card">
            <div class="post-title">{post.data.title}</div>
            <div class="post-date">
              {new Date(post.data.pubDate).toLocaleDateString()}
            </div>
            {post.data.description && (
              <div class="post-desc">{post.data.description}</div>
            )}
          </a>
        ))}
      </div>

      <!-- Back navigation links -->
      <div class="nav-links">
        <a href="/blog/categories">← 全カテゴリ一覧へ</a>
        <a href="/">← ブログトップへ</a>
      </div>
    </main>
  </body>
</html>
