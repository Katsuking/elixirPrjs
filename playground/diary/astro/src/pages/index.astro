---
import { getCollection } from 'astro:content';

// Fetch all posts from content collections
const posts = await getCollection('blog');
const title = "WayUp Blog";
---

<!usr/html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <style>
      /* Base styles for static Astro homepage */
      body {
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        background-color: #0f172a;
        color: #f8fafc;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        margin: 0;
        padding: 1rem;
      }
      .card {
        background-color: #1e293b;
        padding: 2.5rem;
        border-radius: 1rem;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3);
        max-width: 600px;
        width: 100%;
      }
      h1 {
        color: #38bdf8;
        margin-top: 0;
      }
      .post-list {
        list-style: none;
        padding: 0;
        margin: 1.5rem 0;
      }
      .post-item {
        background-color: #0f172a;
        padding: 1rem;
        border-radius: 0.5rem;
        margin-bottom: 0.75rem;
        border: 1px solid #334155;
      }
      a {
        color: #f43f5e;
        text-decoration: none;
        font-weight: bold;
      }
      a:hover {
        text-decoration: underline;
      }
    </style>
  </head>
  <body>
    <div class="card">
      <h1>🚀 Welcome to {title}</h1>
      <p>This blog is built with Astro & Bun, supporting MDX and React.</p>

      <h2>Latest Articles</h2>
      <ul class="post-list">
        {posts.map(post => (
          <li class="post-item">
            <a href={`/blog/${post.slug}`}>{post.data.title}</a>
            <p style="margin: 0.25rem 0 0; color: #94a3b8; font-size: 0.9rem;">
              {post.data.description}
            </p>
          </li>
        ))}
      </ul>

      <p><a href="https://wayup.cc">← Back to Main App (wayup.cc)</a></p>
    </div>
  </body>
</html>
