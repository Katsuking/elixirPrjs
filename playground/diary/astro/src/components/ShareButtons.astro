---
// Extended SNS Share Buttons component
interface Props {
  title: string;
  url?: string;
}

const { title, url = Astro.url.href } = Astro.props;

const encodedTitle = encodeURIComponent(title);
const encodedUrl = encodeURIComponent(url);

// Construct share URLs
const shareLinks = {
  x: `https://x.com/intent/post?text=${encodedTitle}&url=${encodedUrl}`,
  bluesky: `https://bsky.app/intent/compose?text=${encodedTitle}%20${encodedUrl}`,
  line: `https://social-plugins.line.me/lineit/share?url=${encodedUrl}`,
  hatena: `https://b.hatena.ne.jp/entry/s/${url.replace(/^https?:\/\//, '')}`,
  pocket: `https://getpocket.com/edit?url=${encodedUrl}&title=${encodedTitle}`,
  facebook: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`,
  linkedin: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`,
};
---

<div class="share-container">
  <span class="share-title">この記事をシェアする:</span>
  <div class="share-buttons">
    <a href={shareLinks.x} target="_blank" rel="noopener noreferrer" class="btn btn-x" title="Share on X">
      X
    </a>
    <a href={shareLinks.bluesky} target="_blank" rel="noopener noreferrer" class="btn btn-bluesky" title="Share on Bluesky">
      Bluesky
    </a>
    <a href={shareLinks.line} target="_blank" rel="noopener noreferrer" class="btn btn-line" title="Share on LINE">
      LINE
    </a>
    <a href={shareLinks.hatena} target="_blank" rel="noopener noreferrer" class="btn btn-hatena" title="Bookmark on Hatena">
      B!
    </a>
    <a href={shareLinks.pocket} target="_blank" rel="noopener noreferrer" class="btn btn-pocket" title="Save to Pocket">
      Pocket
    </a>
    <a href={shareLinks.facebook} target="_blank" rel="noopener noreferrer" class="btn btn-facebook" title="Share on Facebook">
      Facebook
    </a>
    <a href={shareLinks.linkedin} target="_blank" rel="noopener noreferrer" class="btn btn-linkedin" title="Share on LinkedIn">
      LinkedIn
    </a>
    <button type="button" class="btn btn-copy" id="copyUrlBtn" title="Copy URL">
      Copy URL
    </button>
  </div>
</div>

<script>
  // Client-side script to handle copy URL functionality
  const copyBtn = document.getElementById('copyUrlBtn');
  if (copyBtn) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        const originalText = copyBtn.innerText;
        copyBtn.innerText = 'Copied!';
        setTimeout(() => {
          copyBtn.innerText = originalText;
        }, 2000);
      } catch (err) {
        console.error('Failed to copy URL: ', err);
      }
    });
  }
</script>

<style>
  /* Share buttons container styling */
  .share-container {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid #334155;
  }
  .share-title {
    display: block;
    font-size: 0.9rem;
    color: #94a3b8;
    margin-bottom: 0.75rem;
    font-weight: 600;
  }
  .share-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.4rem 0.8rem;
    font-size: 0.8rem;
    font-weight: 600;
    border-radius: 0.375rem;
    text-decoration: none;
    color: #ffffff;
    border: none;
    cursor: pointer;
    transition: opacity 0.2s ease, transform 0.1s ease;
  }
  .btn:hover {
    opacity: 0.85;
    transform: translateY(-1px);
  }
  .btn-x { background-color: #000000; border: 1px solid #334155; }
  .btn-bluesky { background-color: #0085ff; }
  .btn-line { background-color: #06c755; }
  .btn-hatena { background-color: #00a4de; }
  .btn-pocket { background-color: #ee4056; }
  .btn-facebook { background-color: #1877f2; }
  .btn-linkedin { background-color: #0a66c2; }
  .btn-copy { background-color: #475569; color: #f8fafc; }
</style>
